# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1

# Database
DATABASE_URL="postgresql://agrobusca:agrobusca123@localhost:5432/agrobuscafacil?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=500

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=AgroBuscaFácil API
SWAGGER_DESCRIPTION=API do Marketplace AgroBuscaFácil v2

# Pagamentos (Mercado Pago)
# MP_ENABLED=true ativa o provedor real; qualquer outro valor (ou ausente) usa o provedor MOCK,
# que aceita tokens "mock-approved:last4:brand", "mock-rejected:last4:brand" e "mock:last4:brand",
# e webhooks com header "x-signature: mock-signature".
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TIMEOUT_MS=10000

# Stripe (PIX/Boleto - fluxo legado)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agrobuscafacil.com.br

# Sentry (opcional)
SENTRY_DSN=
