# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1

# Database
DATABASE_URL="postgresql://agrobusca:agrobusca123@localhost:5432/agrobuscafacil?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=AgroBuscaFácil API
SWAGGER_DESCRIPTION=API do Marketplace AgroBuscaFácil v2

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agrobuscafacil.com.br

# Sentry (opcional)
SENTRY_DSN=
