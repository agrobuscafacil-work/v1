generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
  SUPER_ADMIN
}

enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  PENDING_REVIEW
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  DECLINED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
  CHARGEBACK
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  BANK_TRANSFER
  DEPOSIT
  CASH
}

enum ShippingType {
  FIXED
  CALCULATED_BY_ZIPCODE
  FREE
  SCHEDULED
  PICKUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  SHIPMENT_UPDATED
  SUPPLIER_APPROVED
  SUPPLIER_REJECTED
  PROMOTION
  SYSTEM
  WELCOME
  PASSWORD_CHANGED
  SUPPORT_RESPONSE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportAttachmentType {
  IMAGE
  DOCUMENT
  VIDEO
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String
  document          String    @unique
  phone             String?
  avatarUrl         String?
  role              UserRole  @default(CUSTOMER)
  active            Boolean   @default(true)
  verified          Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExp     DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?
  addresses       Address[]
  orders          Order[]             @relation("CustomerOrders")
  reviews         Review[]
  reviewResponses ReviewResponse[]
  cart            Cart?
  favorites       Favorite[]
  messagesSent    Message[]           @relation("SenderMessages")
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportNotes    SupportTicketNote[]

  @@index([email])
  @@index([document])
  @@index([role])
  @@index([active])
}

model CustomerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate         DateTime?
  gender            String?
  receivePromotions Boolean   @default(true)
  notes             String?
  totalOrders       Int       @default(0)
  totalSpent        Decimal   @default(0) @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

model SupplierProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String
  tradingName           String?
  document              String         @unique
  stateRegistration     String?
  municipalRegistration String?
  description           String?
  logoUrl               String?
  bannerUrl             String?
  website               String?
  phone                 String
  whatsapp              String?
  email                 String
  status                SupplierStatus @default(PENDING)
  statusReason          String?
  approvedAt            DateTime?
  reviewedBy            String?
  rating                Decimal        @default(0) @db.Decimal(3, 2)
  totalReviews          Int            @default(0)
  totalProducts         Int            @default(0)
  totalOrders           Int            @default(0)
  totalSales            Decimal        @default(0) @db.Decimal(12, 2)
  foundedYear           Int?
  employeesCount        Int?
  businessHours         Json?
  deliveryInfo          Json?
  certifications        String[]
  badges                String[]
  socialNetworks        Json?
  featured              Boolean        @default(false)
  viewCount             Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  products        Product[]
  services        Service[]
  orders          Order[]          @relation("SupplierOrders")
  promotions      Promotion[]
  reviews         Review[]
  reviewResponses ReviewResponse[]
  favorites       Favorite[]
  workingHours    WorkingHours[]
  coupons         Coupon[]
  categories      Category[]
  banners         Banner[]
  addresses       Address[]
  chatSettings    ChatSettings?

  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([featured])
}

model Address {
  id           String           @id @default(uuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  supplierId   String?
  supplier     SupplierProfile? @relation(fields: [supplierId], references: [id])
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String           @default("Brasil")
  latitude     Decimal?         @db.Decimal(10, 7)
  longitude    Decimal?         @db.Decimal(10, 7)
  isMain       Boolean          @default(false)
  label        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  orders Order[]

  @@index([zipCode])
  @@index([city, state])
  @@index([userId])
  @@index([supplierId])
}

model Category {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  iconUrl     String?
  imageUrl    String?
  parentId    String?
  parent      Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]       @relation("CategoryHierarchy")
  order       Int              @default(0)
  active      Boolean          @default(true)
  supplierId  String?
  supplier    SupplierProfile? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  products Product[]
  services Service[]

  @@index([slug])
  @@index([parentId])
  @@index([active])
}

model Product {
  id               String          @id @default(uuid())
  supplierId       String
  supplier         SupplierProfile @relation(fields: [supplierId], references: [id])
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  name             String
  slug             String          @unique
  description      String
  shortDescription String?
  brand            String?
  model            String?
  sku              String?         @unique
  barcode          String?
  unit             String          @default("un")
  minimumQuantity  Int             @default(1)
  price            Decimal         @db.Decimal(12, 2)
  comparePrice     Decimal?        @db.Decimal(12, 2)
  costPrice        Decimal?        @db.Decimal(12, 2)
  discountPercent  Int             @default(0)
  stock            Int             @default(0)
  stockAlert       Int             @default(5)
  weight           Decimal?        @db.Decimal(10, 3)
  height           Decimal?        @db.Decimal(10, 2)
  width            Decimal?        @db.Decimal(10, 2)
  depth            Decimal?        @db.Decimal(10, 2)
  images           String[]
  videos           String[]
  tags             String[]
  specifications   Json?
  status           ProductStatus   @default(ACTIVE)
  statusReason     String?
  featured         Boolean         @default(false)
  freeShipping     Boolean         @default(false)
  allowPickup      Boolean         @default(true)
  preparationTime  Int             @default(1)
  viewCount        Int             @default(0)
  saleCount        Int             @default(0)
  rating           Decimal         @default(0) @db.Decimal(3, 2)
  totalReviews     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]
  favorites  Favorite[]
  promotions Promotion[]
  coupons    Coupon[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([price])
  @@index([featured])
  @@index([rating])
}

model Service {
  id               String          @id @default(uuid())
  supplierId       String
  supplier         SupplierProfile @relation(fields: [supplierId], references: [id])
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  name             String
  slug             String          @unique
  description      String
  shortDescription String?
  price            Decimal?        @db.Decimal(12, 2)
  priceType        String          @default("FIXED")
  serviceArea      String?
  duration         Int?
  durationUnit     String          @default("hours")
  images           String[]
  tags             String[]
  specifications   Json?
  status           ProductStatus   @default(ACTIVE)
  featured         Boolean         @default(false)
  viewCount        Int             @default(0)
  rating           Decimal         @default(0) @db.Decimal(3, 2)
  totalReviews     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  reviews Review[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([featured])
}

model Promotion {
  id            String           @id @default(uuid())
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      SupplierProfile? @relation(fields: [supplierId], references: [id])
  title         String
  description   String?
  discountType  String           @default("PERCENTAGE")
  discountValue Decimal          @db.Decimal(12, 2)
  minQuantity   Int?
  maxQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productId])
  @@index([supplierId])
  @@index([active, startDate, endDate])
}

model Coupon {
  id             String          @id @default(uuid())
  supplierId     String
  supplier       SupplierProfile @relation(fields: [supplierId], references: [id])
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  code           String          @unique
  description    String?
  discountType   String          @default("PERCENTAGE")
  discountValue  Decimal         @db.Decimal(12, 2)
  minOrderValue  Decimal?        @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int             @default(0)
  maxUsesPerUser Int?
  startDate      DateTime
  endDate        DateTime
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orderCoupons OrderCoupon[]

  @@index([supplierId])
  @@index([code])
  @@index([active, startDate, endDate])
}

model WorkingHours {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isOpen     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([supplierId, dayOfWeek])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                 String          @id @default(uuid())
  orderNumber        String          @unique
  customerId         String
  customer           User            @relation("CustomerOrders", fields: [customerId], references: [id])
  supplierId         String
  supplier           SupplierProfile @relation("SupplierOrders", fields: [supplierId], references: [id])
  status             OrderStatus     @default(PENDING)
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentMethod      PaymentMethod?
  paymentId          String?
  subtotal           Decimal         @db.Decimal(12, 2)
  discount           Decimal         @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  shippingType       ShippingType?
  shippingData       Json?
  addressId          String?
  deliveryAddress    Address?        @relation(fields: [addressId], references: [id])
  trackingCode       String?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  notes              String?
  invoiceUrl         String?
  invoiceNumber      String?
  cancellationReason String?
  refundAmount       Decimal?        @db.Decimal(12, 2)
  refundedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  payment       Payment?
  items         OrderItem[]
  coupons       OrderCoupon[]
  statusHistory OrderStatusHistory[]
  messages      Message[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderCoupon {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([couponId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedBy String?
  reason    String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Review {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  supplierId      String
  supplier        SupplierProfile  @relation(fields: [supplierId], references: [id])
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id])
  serviceId       String?
  service         Service?         @relation(fields: [serviceId], references: [id])
  orderId         String?
  rating          Int
  title           String?
  comment         String?
  images          String[]
  status          ReviewStatus     @default(PENDING)
  moderatorId     String?
  moderatedAt     DateTime?
  helpfulCount    Int              @default(0)
  reviewResponses ReviewResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, productId])
  @@unique([userId, serviceId])
  @@index([supplierId])
  @@index([productId])
  @@index([serviceId])
  @@index([status])
  @@index([rating])
}

model ReviewResponse {
  id         String          @id @default(uuid())
  reviewId   String
  review     Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  comment    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([reviewId])
  @@index([supplierId])
}

model Favorite {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   SupplierProfile? @relation(fields: [supplierId], references: [id])
  productId  String?
  product    Product?         @relation(fields: [productId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([userId, supplierId])
  @@unique([userId, productId])
  @@index([userId])
}

model Conversation {
  id         String   @id @default(uuid())
  supplierId String
  customerId String
  orderId    String?
  subject    String?
  isActive   Boolean  @default(true)
  isBlocked  Boolean  @default(false)
  blockedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@unique([supplierId, customerId])
  @@index([supplierId])
  @@index([customerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  type           MessageType  @default(TEXT)
  content        String
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  gateway         String?
  gatewayId       String?
  gatewayResponse Json?
  pixCode         String?
  pixQrCode       String?
  boletoUrl       String?
  boletoBarCode   String?
  cardLastDigits  String?
  cardBrand       String?
  installments    Int?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([gatewayId])
}

model ChatSettings {
  id               String          @id @default(uuid())
  supplierId       String          @unique
  supplier         SupplierProfile @relation(fields: [supplierId], references: [id])
  autoReply        Boolean         @default(false)
  autoReplyMessage String?
  workingHoursOnly Boolean         @default(false)
  responseTime     Int?
  welcomeMessage   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

model Banner {
  id          String           @id @default(uuid())
  supplierId  String?
  supplier    SupplierProfile? @relation(fields: [supplierId], references: [id])
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  linkUrl     String?
  position    String           @default("HOME_TOP")
  order       Int              @default(0)
  active      Boolean          @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([position, active])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id            String    @id @default(uuid())
  reporterId    String?
  reportedId    String?
  reportedType  String
  reason        String
  description   String?
  status        String    @default("PENDING")
  moderatorId   String?
  moderatorNote String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([reportedType])
}

model SupportCategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String
  icon        String
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  types   SupportType[]
  tickets SupportTicket[]

  @@index([active])
  @@index([order])
}

model SupportType {
  id          String          @id @default(uuid())
  categoryId  String
  category    SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tickets SupportTicket[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([active])
}

model SupportTicket {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  categoryId    String
  category      SupportCategory     @relation(fields: [categoryId], references: [id])
  typeId        String
  type          SupportType         @relation(fields: [typeId], references: [id])
  title         String
  description   String
  status        SupportTicketStatus @default(OPEN)
  pageUrl       String?
  browser       String?
  os            String?
  device        String?
  appVersion    String?
  adminResponse String?
  respondedBy   String?
  respondedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  attachments   SupportAttachment[]
  notes         SupportTicketNote[]
  statusHistory SupportTicketStatusHistory[]

  @@index([userId])
  @@index([categoryId])
  @@index([typeId])
  @@index([status])
  @@index([createdAt])
}

model SupportAttachment {
  id        String                @id @default(uuid())
  ticketId  String
  ticket    SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      SupportAttachmentType
  fileName  String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime              @default(now())

  @@index([ticketId])
}

model SupportTicketNote {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User          @relation(fields: [adminId], references: [id])
  note      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model SupportTicketStatusHistory {
  id        String              @id @default(uuid())
  ticketId  String
  ticket    SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status    SupportTicketStatus
  changedBy String?
  note      String?
  createdAt DateTime            @default(now())

  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
}
