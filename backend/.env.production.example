# BACKEND - PRODUÇÃO (servidor Docker/NGINX)
# Copie para backend/.env no servidor de produção.

# App
NODE_ENV=production
PORT=4000
API_PREFIX=api
API_VERSION=v1

# Database (no docker-compose o host é "postgres")
DATABASE_URL="postgresql://agrobusca:agrobusca123@postgres:5432/agrobuscafacil?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - use `openssl rand -base64 48` para gerar chaves fortes
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS - domínio(s) do frontend (separados por vírgula).
# Cloud Run: https://www.agrobuscafacil.com.br  (Vercel, se ainda usada: https://www.agrobuscafacil.com.br)
CORS_ORIGIN=https://www.agrobuscafacil.com.br

# Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=500

# Upload - use um volume persistente no docker-compose
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Uploads persistentes no Google Cloud Storage (opcional).
# Quando GCS_BUCKET está definido, imagens/anexos vão para o bucket em vez do disco.
GCS_PROJECT_ID=
GCS_BUCKET=
# Arquivo JSON da service account (no container: /etc/gcp/credentials.json)
GCS_CREDENTIALS_FILE=/etc/gcp/credentials.json
# URL pública do bucket quando ele é público (ex.: https://storage.googleapis.com/SEU-BUCKET)
GCS_PUBLIC_BASE_URL=
# Bucket PRIVADO para anexos de suporte (nunca público). O backend serve o
# arquivo com autenticação + checagem de dono/admin.
GCS_PRIVATE_BUCKET=

# Swagger - desabilite em produção se desejar
SWAGGER_ENABLED=true
SWAGGER_TITLE=AgroBuscaFácil API
SWAGGER_DESCRIPTION=API do Marketplace AgroBuscaFácil v2

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@agrobuscafacil.com.br

# Sentry (opcional)
SENTRY_DSN=