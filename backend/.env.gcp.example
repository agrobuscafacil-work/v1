# ============================================================
# AgroBuscaFácil - BACKEND no Google Cloud (Compute Engine e2-micro)
# Copie para backend/.env.gcp na VM e edite os segredos.
# O deploy-vm.sh lê este arquivo para interpolar o docker-compose.gcp.yml.
# ============================================================

# Postgres (senha do usuário "agrobusca")
POSTGRES_PASSWORD=troque-esta-senha

# Redis
REDIS_PASSWORD=troque-esta-senha-tambem

# CORS - origens autorizadas (separadas por vírgula).
# Inclua o domínio do Cloud Run/frontend e o da Vercel se ainda existir.
CORS_ORIGIN=https://www.agrobuscafacil.com.br

# JWT - gere com `openssl rand -base64 48`
JWT_SECRET=troque-este-segredo-jwt
JWT_REFRESH_SECRET=troque-este-segredo-refresh

# Google Cloud Storage (imagens/anexos persistentes)
GCS_PROJECT_ID=SEU-PROJETO-GCP
# Bucket PÚBLICO (somente leitura) para imagens de produto/banners.
GCS_BUCKET=SEU-BUCKET-PUBLICO-GLOBAL
# URL pública do bucket (apenas leitura).
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/SEU-BUCKET-PUBLICO-GLOBAL
# Bucket PRIVADO para anexos de suporte (documentos/dados do usuário).
# NUNCA torne este bucket público; o backend serve o arquivo com autorização.
GCS_PRIVATE_BUCKET=SEU-BUCKET-PRIVADO-GLOBAL

# Bucket usado pelo script de backup (backup-db.sh)
BACKUP_BUCKET=SEU-BUCKET-PRIVADO-GLOBAL
