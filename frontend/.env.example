# Vercel (frontend) — defina estas variáveis no painel do Vercel
# (Settings -> Environment Variables -> Production/Preview)

# Aponta para o MESMO domínio (rewrite em vercel.json encaminha /api -> backend).
# No Vercel: NEXT_PUBLIC_API_URL=/api/v1
# No Cloud Run: use o absoluto https://api.agrobuscafacil.com.br/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# URL do Socket.IO (chat). Deixe vazio para usar o mesmo domínio (recomendado no Vercel).
# No Cloud Run: https://api.agrobuscafacil.com.br
NEXT_PUBLIC_SOCKET_URL=

NEXT_PUBLIC_APP_NAME=AgroBuscaFácil
NEXT_PUBLIC_APP_URL=https://www.agrobuscafacil.com.br
